<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config cho site IIS của frontend NOIBO (noibo.thuanhunglongan.com).
  KHÔNG tự copy vào build/. Đối chiếu với web.config đang có trên server trước
  khi thay — xem iis/README.md.
-->
<configuration>
  <system.webServer>

    <!-- Nén gzip file tĩnh (JS/CSS/HTML/JSON/SVG). Cần cài feature
         "Static Content Compression" của IIS, nếu không thì dòng này không có tác dụng. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!-- React Router: mọi đường dẫn không phải file/thư mục thật → index.html -->
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- File trong static/ có hash trong tên (main.8d02f990.js) → nội dung không bao giờ
       đổi dưới cùng một tên → cho trình duyệt cache 1 năm, không cần hỏi lại server. -->
  <location path="static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- index.html / sw.js / manifest.json luôn phải hỏi lại server, để người dùng
       nhận bản deploy mới ngay (index.html trỏ tới tên file JS mới). -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="manifest.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
